---
const aboutLinks = [
    { name: 'Nosotros', href: '/about' },
    { name: 'Staff', href: '/staff' },
    { name: 'Servicios', href: '/services' },
    { name: 'Resultados', href: '/results' },
    { name: 'Contacto', href: '/contact' },
];

const practiceAreas = [
    { name: 'Lavado de activos', href: '/services' },
    { name: 'Delitos contra la administración pública', href: '/services' },
    { name: 'Delitos contra la vida', href: '/services' },
    { name: 'Delitos patrimoniales', href: '/services' },
    { name: 'Delitos informáticos', href: '/services' },
];

const workingHours = [
    { day: 'Lun', time: '8:30 AM - 5:30 PM' },
    { day: 'Mar', time: '8:30 AM - 5:30 PM' },
    { day: 'Mié', time: '8:30 AM - 5:30 PM' },
    { day: 'Jue', time: '8:30 AM - 5:30 PM' },
    { day: 'Vie', time: '8:30 AM - 5:30 PM' },
];
---

<footer class="bg-[#0f0f0f] px-4 py-16 font-serif text-gray-400">
    <div
        class="mx-auto grid max-w-7xl grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-4"
    >
        <div class="space-y-6">
            <div class="flex items-center gap-3">
                <img
                    src="/logo-website.png"
                    alt="logo de Muña & Cardenas Abogados"
                    class="h-14 w-auto"
                />
            </div>
            <div class="space-y-2 text-sm not-italic">
                <p>Urb. Surihuaylla Grande Q-10, Los Nogales, San Sebastián – Cusco</p>
                <p>+51 964 047 119</p>
                <p>contacto@munaycardenas.com</p>
            </div>
            <div class="flex gap-4 text-white">
                <a href="#" class="transition-colors hover:text-gray-400">FB</a>
                <a href="#" class="transition-colors hover:text-gray-400">TW</a>
                <a href="#" class="transition-colors hover:text-gray-400">IG</a>
            </div>
        </div>

        <div>
            <h3 class="mb-6 text-xl font-semibold text-white">Nosotros</h3>
            <ul class="space-y-3 text-sm">
                {
                    aboutLinks.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                class="transition-colors hover:text-white"
                            >
                                {link.name}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>

        <div>
            <h3 class="mb-6 text-xl font-semibold text-white">
                Áreas de práctica
            </h3>
            <ul class="space-y-3 text-sm">
                {
                    practiceAreas.map((area) => (
                        <li>
                            <a
                                href={area.href}
                                class="transition-colors hover:text-white"
                            >
                                {area.name}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>

        <div>
            <h3 class="mb-6 text-xl font-semibold text-white">Horario de atención</h3>
            <ul class="space-y-3 text-sm">
                {
                    workingHours.map((item) => (
                        <li class="flex justify-between md:justify-start md:gap-4">
                            <span class="text-white">{item.day}:</span>
                            <span>{item.time}</span>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>

    <div
        class="mx-auto mt-16 max-w-7xl border-t border-gray-800 pt-8 text-center text-xs tracking-widest text-gray-600 uppercase"
    >
        Copyright © 2025 Muña & Cardenas - Abogados Penalistas
    </div>
</footer>
