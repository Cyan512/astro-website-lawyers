---
import Container from '@/components/Container.astro';
import Link from '@/components/ui/Link.astro';
import DropDown from './DropDown.astro';
import { Astronav, MenuItems, MenuIcon } from 'astro-navbar';
import { cn } from '@/lib/tailwind-utils';

const menuitems = [
    { title: 'Inicio', path: '/' },
    { title: 'Nosotros', path: '/about' },
    { title: 'Staff', path: '/staff' },
    { title: 'Servicios', path: '/services' },
    { title: 'Resultados', path: '/results' },
    { title: 'Contacto', path: '/contact' },
];
---

<header class="fixed top-0 z-50 w-full bg-white shadow-sm">
    <div class="border-gray-200 lg:border-b">
        <Container>
            <div class="flex items-center justify-between">
                <a href="/" class="py-3">
                    <img
                        src="/logo-website.png"
                        alt="logo de Muña & Cardenas Abogados"
                        class="h-14 w-auto lg:h-16"
                    />
                </a>
                <div class="hidden items-center gap-4 lg:flex">
                    <span class="text-sm font-medium text-slate-600">
                        Consulta gratuita
                    </span>
                    <Link href="tel:+51964047119" size="md">
                        Llama: +51 964 047 119
                    </Link>
                </div>
                <div class="block lg:hidden">
                    <MenuIcon class="h-6 w-6 text-gray-800" />
                </div>
            </div>
        </Container>
    </div>

    <Container>
        <div class="mt-2 w-full lg:mt-0">
            <Astronav>
                <MenuItems class="hidden w-full justify-end lg:flex">
                    <ul class="flex flex-col lg:flex-row lg:gap-1">
                        {
                            menuitems.map((item, index) => (
                                <>
                                    {item.children ? (
                                        <DropDown
                                            title={item.title}
                                            children={item.children}
                                            lastItem={
                                                index === menuitems.length - 1
                                            }
                                        />
                                    ) : (
                                        <li>
                                            <a
                                                href={item.path}
                                                class="flex items-center py-3 text-sm font-medium uppercase tracking-wide text-slate-700 transition-colors hover:text-[var(--color-theme)] lg:px-4 lg:py-4"
                                            >
                                                {item.title}
                                            </a>
                                        </li>
                                    )}
                                </>
                            ))
                        }
                    </ul>
                </MenuItems>
            </Astronav>
        </div>
    </Container>
</header>
