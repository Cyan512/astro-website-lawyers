---
const features = [
    {
        title: 'Lavado de activos',
        description:
            'Defensa estratégica en casos de lavado de activos con resultados exitosos para nuestros clientes.',
        url: '/services',
    },
    {
        title: 'Delitos contra la administración pública',
        description:
            'Representación legal en casos de corrupción y delitos cometidos por funcionarios públicos.',
        url: '/services',
    },
    {
        title: 'Delitos contra la vida',
        description:
            'Defensa efectiva en casos de feminicidio, homicide y lesiones personales.',
        url: '/services',
    },
    {
        title: 'Delitos patrimoniales',
        description:
            'Experiencia en casos de robo, hurto, estafa y otros delitos contra el patrimonio.',
        url: '/services',
    },
    {
        title: 'Delitos informáticos',
        description:
            'Defensa en casos de ciberdelitos, fraude electrónico y delitos informaticos.',
        url: '/services',
    },
    {
        title: 'Delitos económicos',
        description:
            'Representación en casos de delitos financieros, cuello blanco y delitos económicos.',
        url: '/services',
    },
];
---

<div class="mt-16 md:mt-0">
    <h2 class="text-center font-title text-3xl font-bold text-slate-900 lg:text-4xl">
        Áreas de práctica
    </h2>
    <p class="mt-4 text-center text-lg leading-relaxed text-slate-600 lg:max-w-2xl lg:mx-auto">
        Somos especialistas en derecho penal. Brindamos defensa legal en
        casos de alta complejidad ante los tribunales del Perú.
    </p>
</div>

<div class="mt-16 grid gap-10 sm:grid-cols-2 md:grid-cols-3">
    {
        features.map((item) => (
            <div class="flex flex-col items-start gap-4 rounded-lg bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
                <div class="flex h-12 w-12 items-center justify-center rounded-full bg-red-700 text-white">
                    <i class="fa-solid fa-gavel text-xl"></i>
                </div>
                <div>
                    <h3 class="text-lg font-semibold text-slate-900">{item.title}</h3>
                    <p class="mt-2 text-base leading-relaxed text-slate-600">
                        {item.description}
                    </p>
                    <a href={item.url} class="mt-3 inline-flex items-center text-sm font-medium text-red-700 hover:text-red-800">
                        Conoce más
                        <i class="fa-solid fa-arrow-right ml-2 text-xs"></i>
                    </a>
                </div>
            </div>
        ))
    }
</div>
