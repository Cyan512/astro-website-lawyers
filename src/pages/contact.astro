---
import Layout from '../layouts/Layout.astro';
import Hero from '@/components/Hero.astro';
import ContactSection from '@/components/ContactSection.astro';
import { MapPin, Phone, Mail, Clock } from '@lucide/astro';
import MapSection from '@/components/MapSection.astro';

const contactItems = [
    {
        icon: MapPin,
        label: 'Urb. Surihuaylla Grande Q-10, Los Nogales, San Sebastián – Cusco',
        type: 'address',
    },
    {
        icon: Phone,
        label: '+51 964 047 119',
        type: 'phone',
    },
    {
        icon: Mail,
        label: 'contacto@munaycardenas.com',
        type: 'email',
    },
    {
        icon: Clock,
        label: '8:30 AM - 5:30 PM',
        type: 'hours',
    },
];
---

<Layout title="Contacto - Muña & Cardenas">
    <Hero title="Contacto" />

    <ContactSection
        formTitle="Evalúa tu caso con nosotros"
        formSubtitle="Las consultas son gratuitas"
    >
        <div class="space-y-6">
            <h2
                class="font-title text-3xl leading-tight font-bold text-slate-900 lg:text-4xl"
            >
                Información de contacto
            </h2>
            <p class="text-base leading-relaxed text-slate-600">
                Estamos aquí para ayudarte. Contáctanos para una asesoría legal
                gratuita y descubre cómo podemos defender tus derechos.
            </p>

            <div class="mt-6 space-y-4">
                {
                    contactItems.map((item) => {
                        const Icon = item.icon;
                        return (
                            <div class="flex items-center space-x-4">
                                <Icon class="text-theme h-6 w-6 shrink-0" />
                                <span class="text-lg text-slate-700">
                                    {item.label}
                                </span>
                            </div>
                        );
                    })
                }
            </div>
        </div>
    </ContactSection>
    <MapSection />
</Layout>
