---
import Layout from '../layouts/Layout.astro';
import Container from '@/components/Container.astro';
import ContactSection from '@/components/ContactSection.astro';
import Hero from '@/components/Hero.astro';

const generalServices = [
    'Asesoramiento y defensa en casos penales',
    'Representación en juicios y audiencias',
    'Recursos y apelaciones',
    'Investigación y recolección de pruebas',
    'Negociación y acuerdo con la fiscalía',
    'Asesoramiento en materia de derechos humanos',
];

const services = [
    {
        id: '01',
        title: 'Delito de lavado de activos.',
        description:
            'Contamos con una amplia experiencia en este delito, actualmente venimos realizando la defensa exitosa de varios casos.',
        image: 'https://images.unsplash.com/photo-1554224155-6726b3ff858f?auto=format&fit=crop&q=80&w=1000',
    },
    {
        id: '02',
        title: 'Delitos contra la administración publica.',
        description:
            'Una gran cantidad de nuestros casos son de esta materia, actualmente venimos defendiendo a diversos funcionarios públicos y empresarios.',
        image: 'https://images.unsplash.com/photo-1589829085413-56de8ae18c73?auto=format&fit=crop&q=80&w=1000',
    },
    {
        id: '03',
        title: 'Delitos contra la vida y la integridad física',
        description:
            'Estos delitos son de mucha relevancia en nuestra sociedad, siendo muchos de nuestros casos estos delitos.',
        image: 'https://images.unsplash.com/photo-1505664194779-8beaceb93744?auto=format&fit=crop&q=80&w=1000',
    },
    {
        id: '04',
        title: 'Delitos contra la propiedad y el patrimonio',
        description:
            'Estos delitos se han incrementado en nuestra sociedad, en la actualidad nuestro estudio viene trabajando con multiples casos, contado con experiencia en esta area.',
        image: 'https://images.unsplash.com/photo-1560518883-ce09059eeffa?auto=format&fit=crop&q=80&w=1000',
    },
    {
        id: '05',
        title: 'Delitos contra la libertad y la seguridad sexual',
        description:
            'Este delito es uno de los mas complejos, esto debido a la gran carga emocional, por el que afronta la familia y las personas que estan imersas en estos procesos.',
        image: 'https://images.unsplash.com/photo-1453928582365-b6ad33cbcf64?auto=format&fit=crop&q=80&w=1000',
    },
    {
        id: '06',
        title: 'Delitos económicos y financieros',
        description:
            'Este es un delito que ha venido evolucionando en nuestra sociedad, los delitos de cuello blanco, actualmente nuestra empresas viene llevando multiples casos de este tipo.',
        image: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&q=80&w=1000',
    },
    {
        id: '07',
        title: 'Delitos informáticos y ciberdelitos',
        description:
            'Con el desarrollo de la tecnologia, tambien se ha desarrollado este delito, siendo uno de los delitos con suma complejidad.',
        image: 'https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&q=80&w=1000',
    },
    {
        id: '08',
        title: 'Delitos contra la salud pública',
        description:
            'Este es un delito que afecta a toda la sociedad y suele cometerse con frecuencia, nuestro estudio viene litigando en esta area con mucho exito,',
        image: 'https://images.unsplash.com/photo-1532938911079-1b06ac7ceec7?auto=format&fit=crop&q=80&w=1000',
    },
];
---

<Layout title="Servicios - Muña & Cardenas">
    <Hero title="Servicios" />

    <div class="bg-slate-50 py-16 lg:py-24">
        <Container>
            <div class="grid items-center gap-12 lg:grid-cols-2">
                <div>
                    <h2
                        class="font-title text-4xl font-bold text-slate-900 lg:text-5xl"
                    >
                        Nuestro estudio te brinda:
                    </h2>
                    <p class="mt-4 text-lg text-slate-600">
                        Ofrecemos una defensa integral y estratégica en cada etapa
                        del proceso penal.
                    </p>
                </div>
                <div>
                    <ul class="grid gap-4 sm:grid-cols-2">
                        {
                            generalServices.map((service) => (
                                <li class="flex items-start">
                                    <span class="mr-2 mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[var(--color-theme)] text-xs text-white">
                                        ✓
                                    </span>
                                    <span class="text-slate-700">
                                        {service}
                                    </span>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>
        </Container>
    </div>

    <div class="bg-white pb-24 pt-16">
        <Container>
            <div class="space-y-24">
                {
                    services.map((service, index) => (
                        <div
                            class={`flex flex-col gap-12 lg:items-center ${index % 2 === 1 ? 'lg:flex-row-reverse' : 'lg:flex-row'}`}
                        >
                            <div class="w-full lg:w-1/2">
                                <div class="relative aspect-[4/3] overflow-hidden rounded-2xl shadow-xl">
                                    <img
                                        src={service.image}
                                        alt={service.title}
                                        class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
                                        loading="lazy"
                                        decoding="async"
                                    />
                                </div>
                            </div>
                            <div class="w-full lg:w-1/2">
                                <span class="font-title text-xl font-bold text-[var(--color-theme)]">
                                    {service.id}.
                                </span>
                                <h3 class="font-title mt-2 text-3xl font-bold text-slate-900 lg:text-4xl">
                                    {service.title}
                                </h3>
                                <p class="mt-6 text-lg leading-relaxed text-slate-600">
                                    {service.description}
                                </p>
                                <a
                                    href="/contact"
                                    class="group mt-8 inline-flex items-center font-semibold text-[var(--color-theme)] hover:text-red-800"
                                >
                                    Obtener asesoría
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="ml-2 h-5 w-5 transition-transform group-hover:translate-x-1"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <line x1="5" y1="12" x2="19" y2="12" />
                                        <polyline points="12 5 19 12 12 19" />
                                    </svg>
                                </a>
                            </div>
                        </div>
                    ))
                }
            </div>
        </Container>
    </div>
    <ContactSection />
</Layout>
